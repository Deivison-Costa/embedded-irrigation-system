# ---------------------------------------------------------------------------
# embedded-irrigation-system - project defaults
# Generated for ESP-IDF v5.5.x / target esp32
# ---------------------------------------------------------------------------

# --- Partition table -------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Flash / CPU -----------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
# A frequência da CPU é definida na seção "Alimentação / RF", no fim do arquivo:
# ela deixou de ser uma escolha de desempenho e passou a ser uma escolha de
# corrente.

# --- Console ---------------------------------------------------------------
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- FreeRTOS --------------------------------------------------------------
# 1 kHz tick keeps the DHT bit-bang timing windows and the Modbus 3.5-char
# inter-frame delays expressible in whole ticks.
CONFIG_FREERTOS_HZ=1000

# --- Task watchdog ---------------------------------------------------------
# Every long-running task in this firmware subscribes explicitly.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# --- Wi-Fi -----------------------------------------------------------------
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# --- LWIP ------------------------------------------------------------------
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
# SNTP is required: TLS certificate validity cannot be checked without a clock.
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# --- mbedTLS ---------------------------------------------------------------
# 4 kB is not enough for many public broker chains; 8 kB avoids
# MBEDTLS_ERR_SSL_INVALID_RECORD / -0x7200 handshake failures.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_HARDWARE_SHA=y

# --- MQTT ------------------------------------------------------------------
CONFIG_MQTT_TASK_STACK_SIZE=8192
CONFIG_MQTT_TRANSPORT_SSL=y

# --- SNTP / validação de data do certificado --------------------------------
# esp_netif_sntp com server_from_dhcp exige esta opcao; sem ela o
# esp_netif_sntp_init() devolve ESP_ERR_INVALID_ARG e o relogio nunca e acertado.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
# Sem isto o mbedTLS ignora notBefore/notAfter: a cadeia e verificada por
# assinatura, mas um certificado expirado passaria. Depende do relogio acima.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y

# --- Logging ---------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# --- Alimentação / RF -------------------------------------------------------
# A placa ficava presa num loop de reset (~1,4 Hz) morrendo sempre no mesmo
# ponto: logo apos "phy_init", a maior demanda de corrente de todo o boot
# (calibracao de RF + ligacao do PA, pico da ordem de 400 mA). O trilho de
# 3,3 V nao sustentava esse degrau, o detector de brownout comecava a imprimir
# e a tensao continuava caindo ate abaixo do limiar de power-on reset - por
# isso o motivo registrado era "rst:0x1 (POWERON_RESET)" e nao brownout.
#
# 1) Nivel 7 (2,80 V) faz o detector disparar ENQUANTO ainda ha margem, de modo
#    que a ISR consegue gravar a dica ESP_RST_BROWNOUT e concluir um reset de
#    software limpo. No nivel 0 (2,43 V, o padrao anterior) ele disparava tarde
#    demais e o evento chegava mascarado de power-on.
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
# 2) Com a dica acima preservada, o proprio ESP-IDF sobe o radio na potencia
#    minima no boot seguinte a um brownout - o caminho de recuperacao que o
#    nivel 0 impedia de existir.
CONFIG_ESP_PHY_REDUCE_TX_POWER=y
# 3) E, antes de tudo isso, baixa o teto de potencia de TX. Vale para os dados
#    de inicializacao do PHY, ou seja, ja reduz o pico do proprio phy_init.
#    10 dBm e o minimo que o PHY do ESP32 aceita (o piso da tabela e 40, em
#    unidades de 0,25 dBm). Custo: alcance de Wi-Fi menor.
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=10
# 4) 80 MHz em vez de 240 MHz. Nao e o pico de RF, e a corrente de base sobre a
#    qual esse pico se soma - e nesta placa foi o que decidiu. Medido: a 240 MHz
#    a placa morre no phy_init mesmo a 10 dBm; a 80 MHz ela sobe e opera.
#    Custo: handshake TLS mais lento. O bit-bang do DHT22 nao e afetado - o
#    driver le esp_rom_get_cpu_ticks_per_us() na criacao e se ajusta sozinho
#    (o que ele nao tolera e escalonamento dinamico, CONFIG_PM_ENABLE).
#
# Os itens 3 e 4 compensam uma fonte fraca; NAO sao a correcao definitiva.
# Depois de resolver a alimentacao (ver README, secao "Loop de reset"), volte
# para CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240 e 20 dBm - o item 1 e o 2 valem
# manter para sempre, porque sao deteccao e recuperacao, nao concessao.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
